{
	"description": "The CodeIgniter framework",
	"name": "codeigniter/framework",
	"type": "project",
	"homepage": "https://codeigniter.com",
	"license": "MIT",
	"support": {
		"forum": "https://forum.codeigniter.com/",
		"wiki": "https://github.com/bcit-ci/CodeIgniter/wiki",
		"slack": "https://codeigniterchat.slack.com",
		"source": "https://github.com/bcit-ci/CodeIgniter"
	},
	  "require": {
	    "php": ">=8.1",
	    "ext-mbstring": "*",
	    "kodhe/framework": "^1.0",
	    "kodhe/database": "^1.0",
	    "kodhe/auth": "^1.0",
	    "kodhe/http": "^1.1",
	    "kodhe/agent": "^2.0",
	    "kodhe/view": "^1.1",
	    "kodhe/migration": "^1.1",
	    "kodhe/cache": "^1.1",
	    "kodhe/calendar": "^1.1",
	    "kodhe/cart": "^2.0",
	    "kodhe/driver": "^2.0",
	    "kodhe/email": "^1.0",
	    "kodhe/encrypt": "^1.0",
	    "kodhe/encryption": "^1.0",
	    "kodhe/ftp": "^1.0",
	    "kodhe/http": "^1.1",
	    "kodhe/image": "^1.1",
	    "kodhe/javascript": "^1.1",
	    "kodhe/migration": "^1.1",
	    "kodhe/pagination": "^2.0",
	    "kodhe/parser": "^1.0",
	    "kodhe/profiler": "^1.1",
	    "kodhe/session": "^1.1",
	    "kodhe/session": "^1.1",
	    "kodhe/table": "^1.1",
	    "kodhe/test": "^2.0",
	    "kodhe/trackback": "^1.1",
	    "kodhe/typography": "^1.1",
	    "kodhe/upload": "^1.1",
	    "kodhe/validation": "^1.1",
	    "kodhe/xmlrpc": "^1.1",
	    "kodhe/xmlrpcs": "^1.1",
	    "kodhe/zip": "^1.1"
	  },
	"suggest": {
		"paragonie/random_compat": "Provides better randomness in PHP 5.x"
	},
	"scripts": {
		"test:coverage": [
			"@putenv XDEBUG_MODE=coverage",
			"phpunit --color=always --coverage-text --configuration tests/travis/sqlite.phpunit.xml"
		],
		"post-install-cmd": [
			"sed -i s/name{0}/name[0]/ vendor/mikey179/vfsstream/src/main/php/org/bovigo/vfs/vfsStream.php"
		],
		"post-update-cmd": [
			"sed -i s/name{0}/name[0]/ vendor/mikey179/vfsstream/src/main/php/org/bovigo/vfs/vfsStream.php"
		]
	},
	"require-dev": {
		"mikey179/vfsstream": "1.6.*",
		"phpunit/phpunit": "4.* || 5.* || 9.*"
	}
}
